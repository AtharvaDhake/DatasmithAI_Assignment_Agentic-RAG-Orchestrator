# DatasmithAI RAG Orchestrator - Environment Configuration

# 1. AWS Configuration (Used by GitHub Actions)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# 2. Gemini Configuration
# Used by both Agent (Code Explain/Summarize) and Backend (Chat RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Supabase Configuration
# Used for pgvector document embeddings and search
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. Networking (Optional overrides)
# ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
# NEXT_PUBLIC_API_URL=http://your-ec2-ip-or-domain:8000
